name: Forway site analysis V2 isolated acceptance
on:
  push:
    branches: [qa/forway-site-analysis-v2-20261115]
permissions:
  contents: read
jobs:
  qualify:
    if: github.ref_name == 'qa/forway-site-analysis-v2-20261115'
    runs-on: ubuntu-latest
    timeout-minutes: 9
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 26.8.2
      - name: Run bounded owned packet
        run: FORWAY_V2_OUTPUT="$RUNNER_TEMP/forway-site-analysis-v2-proof" python3 tests/scripts/qualify-site-analysis-v2.py
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: forway-site-analysis-v2-${{ github.sha }}
          path: ${{ runner.temp }}/forway-site-analysis-v2-proof
          retention-days: 14
